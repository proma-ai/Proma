# Proma Proactive Memory LLM 配置
# 请填入你自己的 LLM key（仅存本机，.env 已被 .gitignore 排除，不会提交）
# 支持 OpenAI 兼容端点：OpenAI / DeepSeek / 腾讯云 LKE / 其他

MEMORY_LLM_API_KEY=在此填入你的key
MEMORY_LLM_BASE_URL=https://api.deepseek.com/v1
MEMORY_LLM_MODEL=deepseek-chat

# 可选：语义召回（hybrid 检索，解决"我是谁"类语义问句）
# local = 本地 node-llama-cpp + embeddinggemma-300m（离线，模型需先下载到 ~/.node-llama-cpp/models/）
# api = OpenAI 兼容 embedding API（同时设置 MEMORY_EMBEDDING_MODEL）
# 默认不设置 = 仅关键词召回（零额外依赖，fail-open）
# PROMA_MEMORY_EMBEDDING=local
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
