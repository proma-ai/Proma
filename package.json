{
  "name": "proma",
  "version": "0.1.1",
  "description": "Proma，为专业用户设计的 Agent",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@proma/electron' dev",
    "electron:dev": "bun run --filter='@proma/electron' dev",
    "electron:build": "bun run --filter='@proma/electron' build",
    "electron:start": "bun run --filter='@proma/electron' start",
    "dist:mac": "bun run --filter='@proma/electron' dist:mac",
  "dist:win": "bun run --filter='@proma/electron' dist:win",
  "dist:linux": "bun run --filter='@proma/electron' dist:linux",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dompurify": "^3.4.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jotai": "^2.17.1"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.84.2": "patches/@earendil-works%2Fpi-ai@0.84.2.patch",
    "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
  }
}
