{
  "name": "@proma/electron",
  "version": "0.19.55",
  "description": "Proma，为专业用户设计的 Agent",
  "main": "dist/main.cjs",
  "author": {
    "name": "ErlichLiu",
    "email": "erlichliu@gmail.com"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev-kill.ts --vite && concurrently -k -n vite,electron -c blue,green \"bun run dev:vite\" \"bun run dev:electron\"",
    "dev:split": "bash scripts/dev-split.sh",
    "dev:vite": "vite dev",
    "dev:kill": "bun run scripts/dev-kill.ts",
    "dev:electron": "bun run dev:kill && bun run sync:runtime-deps:dev && bun run rebuild:node-pty && bun run build:native-helpers && bun run prepare:officecli && bun run build:resources && bun run scripts/dev-bundle-readiness.ts --prepare && concurrently -k -n main,agent-runtime,terminal-runtime,preload,app -c yellow,red,blue,magenta,cyan \"bun run watch:main\" \"bun run watch:agent-runtime\" \"bun run watch:terminal-runtime\" \"bun run watch:preload\" \"bun run scripts/dev-bundle-readiness.ts --wait && bunx electronmon .\"",
    "build:main": "bun run scripts/build-main.ts",
    "build:agent-runtime": "bun run scripts/build-agent-runtime.ts",
    "build:terminal-runtime": "bun run scripts/build-terminal-runtime.ts",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron",
    "watch:main": "bun run scripts/build-main.ts --watch",
    "watch:agent-runtime": "bun run scripts/build-agent-runtime.ts --watch",
    "watch:terminal-runtime": "bun run scripts/build-terminal-runtime.ts --watch",
    "watch:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron --watch=forever",
    "build:renderer": "vite build",
    "build:resources": "cp -r resources dist/ 2>/dev/null || true",
    "build:agent-island-native": "bun run scripts/build-agent-island-native.ts",
    "build:cli": "bun run scripts/build-cli.ts",
    "prepare:officecli": "bun run scripts/prepare-officecli.ts",
    "sync:runtime-deps": "bun run scripts/sync-runtime-deps.ts",
    "sync:runtime-deps:dev": "bun run scripts/sync-runtime-deps.ts --no-clean",
    "build": "bun run prepare:officecli && bun run build:main && bun run build:agent-runtime && bun run build:terminal-runtime && bun run build:preload && bun run build:renderer && bun run build:cli && bun run build:native-helpers && bun run build:resources",
    "rebuild:node-pty": "bun run scripts/rebuild-node-pty.ts && bun run ensure:node-pty-helper",
    "ensure:node-pty-helper": "bun run scripts/ensure-node-pty-helper-executable.ts",
    "start": "bun run build && bunx electron .",
    "typecheck": "tsc --noEmit",
    "generate:icons": "cd resources && ./generate-icons.sh",
    "pack": "bun run build && bun run sync:runtime-deps && bun run rebuild:node-pty && bunx electron-builder@25.1.8 --dir",
    "dist": "bun run build && bun run sync:runtime-deps && bun run rebuild:node-pty && bunx electron-builder@25.1.8",
    "dist:mac": "bun run build && bun run sync:runtime-deps && bun run rebuild:node-pty && bunx electron-builder@25.1.8 --mac",
    "dist:win": "bun run build && bun run sync:runtime-deps && bun run rebuild:node-pty && bunx electron-builder@25.1.8 --win",
    "dist:linux": "node -e \"if (process.platform !== 'linux' || process.arch !== 'x64') throw new Error('dist:linux must run on a Linux x64 host; use the Ubuntu 22.04 release workflow')\" && bun run build && bun run sync:runtime-deps && bun run rebuild:node-pty && bunx electron-builder@25.1.8 --linux",
    "dist:visual": "bun run scripts/dist.ts",
    "dist:fast": "bun run scripts/dist.ts --current-arch --dmg",
    "dist:debug": "bun run scripts/dist.ts --current-arch --verbose",
    "upload:release": "bun run scripts/upload-release.ts",
    "upload:staging": "bun run scripts/upload-release.ts --staging",
    "release:mac": "bun run dist:mac && bun run upload:release",
    "release:win": "bun run dist:win && bun run upload:release",
    "build:eventkit-native": "bun run scripts/build-eventkit-native.ts",
    "build:native-helpers": "bun run build:agent-island-native && bun run build:eventkit-native",
    "release:linux": "bun run dist:linux && bun run upload:release"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-server": "0.85.1",
